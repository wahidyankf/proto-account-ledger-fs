{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "account-ledger-cli",
  "projectType": "application",
  "root": "apps/account-ledger-cli",
  "sourceRoot": "apps/account-ledger-cli/src",
  "targets": {
    "install": {
      "command": "uv sync --locked",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "cache": false
    },
    "typecheck": {
      "command": "uv run --no-sync pyright",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{projectRoot}/tests/**/*.py"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --no-sync ruff check .",
          "uv run --no-sync ruff format --check ."
        ],
        "parallel": false,
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{projectRoot}/tests/**/*.py"
      ]
    },
    "run": {
      "command": "uv run --no-sync python -m account_ledger",
      "options": {
        "cwd": "apps/account-ledger-cli",
        "env": {
          "PYTHONPATH": "src"
        }
      },
      "dependsOn": ["install"],
      "cache": false
    },
    "test:unit": {
      "command": "if grep -rnE --include='*.py' 'pytest\\.skip|mark\\.skip|skipif|mark\\.xfail' tests; then echo 'ERROR: a skipped or expected-failure test is marked above'; exit 1; fi && uv run --no-sync pytest tests/unit --cov=account_ledger --cov-report=term-missing --cov-fail-under=80",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{projectRoot}/tests/conftest.py",
        "{projectRoot}/tests/support/**/*.py",
        "{projectRoot}/tests/unit/**/*.py",
        "{workspaceRoot}/specs/apps/account-ledger/cli/behaviours/**/*.feature"
      ]
    },
    "test:integration": {
      "command": "if grep -rnE --include='*.py' 'pytest\\.skip|mark\\.skip|skipif|mark\\.xfail' tests; then echo 'ERROR: a skipped or expected-failure test is marked above'; exit 1; fi && uv run --no-sync pytest tests/integration",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{projectRoot}/tests/conftest.py",
        "{projectRoot}/tests/support/**/*.py",
        "{projectRoot}/tests/integration/**/*.py",
        "{workspaceRoot}/specs/apps/account-ledger/cli/behaviours/**/*.feature"
      ]
    },
    "test:integration:watch": {
      "command": "uv run --no-sync ptw --now --clear --patterns '*.py,*.feature' --ignore-patterns '*/node_modules/*,*/.venv/*,*/.nx/*,*/.git/*,*/local-tmp/*' ../.. tests/integration",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": false
    },
    "test:e2e": {
      "command": "if grep -rnE --include='*.py' 'pytest\\.skip|mark\\.skip|skipif|mark\\.xfail' tests; then echo 'ERROR: a skipped or expected-failure test is marked above'; exit 1; fi && uv run --no-sync pytest tests/e2e",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{projectRoot}/tests/conftest.py",
        "{projectRoot}/tests/support/**/*.py",
        "{projectRoot}/tests/e2e/**/*.py",
        "{workspaceRoot}/specs/apps/account-ledger/cli/behaviours/**/*.feature"
      ]
    },
    "test:e2e:watch": {
      "command": "uv run --no-sync ptw --now --clear --patterns '*.py,*.feature' --ignore-patterns '*/node_modules/*,*/.venv/*,*/.nx/*,*/.git/*,*/local-tmp/*' ../.. tests/e2e",
      "options": {
        "cwd": "apps/account-ledger-cli"
      },
      "dependsOn": ["install"],
      "cache": false
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec -- nx run account-ledger-cli:typecheck",
          "npm exec -- nx run account-ledger-cli:lint",
          "npm exec -- nx run account-ledger-cli:test:unit"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{projectRoot}/tests/**/*.py",
        "{workspaceRoot}/specs/apps/account-ledger/cli/behaviours/**/*.feature"
      ]
    },
    "test:quick:watch": {
      "command": "npm exec -- nx run account-ledger-cli:test:quick; npm exec -- nx watch --all --includeGlobalWorkspaceFiles -- npm exec -- nx run account-ledger-cli:test:quick",
      "cache": false
    }
  },
  "tags": ["type:app", "platform:cli", "lang:python"]
}
