<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AccountLedgerCli</RootNamespace>
    <AssemblyName>account-ledger-cli</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 1182: report unused variables. 3261/3264: F# nullness interop noise. -->
    <OtherFlags>--warnon:1182 --nowarn:3261 --nowarn:3264</OtherFlags>
  </PropertyGroup>

  <!-- F# compiles in declaration order: the pure core before the shell that uses it. -->
  <ItemGroup>
    <Compile Include="src/Greeting.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>
</Project>
