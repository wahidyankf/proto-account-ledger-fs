{
  "name": "proto-account-ledger-fs",
  "version": "1.0.0",
  "description": "In-memory account ledger core in F#, scaffolded as an Nx monorepo.",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "prepare": "husky",
    "test": "npm run test:quick",
    "test:integration": "nx run-many -t test:integration",
    "test:quick": "nx run-many -t test:quick",
    "test:unit": "nx run-many -t test:unit",
    "typecheck": "nx run-many -t typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahidyankf/proto-account-ledger-fs.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nx": "23.1.1",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,json,jsonc,md,yaml,yml}": "prettier --write"
  }
}
